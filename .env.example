APP_NAME="Ledenadmin Boulodrôme Maastricht"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_TIMEZONE=Europe/Amsterdam

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# true = every admin user must set up two-step verification (MFA) before using the panel.
ADMIN_MFA_REQUIRED=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_JOURNAL_MODE=wal
DB_FOREIGN_KEYS=true
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ledenadministratie@example.com"
MAIL_FROM_NAME="Boulodrôme Maastricht"
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="Ledenadministratie Boulodrôme Maastricht"

# Amazon SES: set MAIL_MAILER=ses. The from-address/domain must be verified in SES (same region).
SES_KEY=
SES_SECRET=
SES_REGION=eu-west-1
SES_CONFIGURATION_SET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public sign-up form (/aanmelden); notifications go to SIGNUP_NOTIFY_ADDRESS or the reply-to address.
SIGNUP_ENABLED=true
SIGNUP_NOTIFY_ADDRESS=

# Languages of the public pages (sign-up, payment, ledenportaal), first = default. Add "en" once lang/en/ exists.
PUBLIC_LOCALES=nl

# Member numbers are shown as PREFIX-0261-CC (CC = check digits).
MEMBER_NUMBER_PREFIX=SBM

# Mollie (iDEAL, Bancontact). Without a key, payment links only show the bank transfer details.
MOLLIE_KEY=
MOLLIE_METHODS=ideal,bancontact
MOLLIE_WEBHOOK_URL=

# Must match the secret used by the old ledenpas tool, so existing card QR codes stay valid.
QR_SECRET=
# Optional: where the QR code points to (default: APP_URL/verify).
CARD_VERIFY_URL=
